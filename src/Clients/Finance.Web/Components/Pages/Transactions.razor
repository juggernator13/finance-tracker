@page "/accounts/{AccountId:guid}"
@inject FinanceApi Api
@inject AuthState Auth
@inject NavigationManager Nav

<h3>Операции</h3>
<a href="/">← к счетам</a>
<p style="color:red">@error</p>

<table>
    <tr><th>Дата</th><th>Описание</th><th>Сумма</th><th></th></tr>
    @foreach (var t in transactions)
    {
        <tr>
            <td>@t.Date.ToString("dd.MM.yyyy")</td>
            <td>@t.Description</td>
            <td>@t.Amount.ToString("N2")</td>
            <td><button @onclick="() => Delete(t.Id)">Удалить</button></td>
        </tr>
    }
</table>

<h4>Новая операция</h4>
<input type="date" @bind="date" />
<input type="number" step="0.01" @bind="amount" />
<input @bind="description" @bind:event="oninput" placeholder="Описание" />
<button @onclick="Add">Добавить</button>
<p>Расход вводите со знаком минус.</p>

@code {
    [Parameter] public Guid AccountId { get; set; }

    List<TransactionDto> transactions = new();
    DateOnly date = DateOnly.FromDateTime(DateTime.Today);
    decimal amount;
    string description = "";
    string? error;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await Load();
    }

    async Task Load()
    {
        try
        {
            error = null;
            transactions = await Api.GetTransactionsAsync(AccountId);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    async Task Add()
    {
        try
        {
            await Api.AddTransactionAsync(AccountId, date, amount, description);
            description = "";
            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    async Task Delete(Guid id)
    {
        try
        {
            await Api.DeleteTransactionAsync(AccountId, id);
            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}